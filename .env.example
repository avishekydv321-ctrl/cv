# VisionSuite — Local PostgreSQL configuration.
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` (it contains your password).

# The PostgreSQL server runs on YOUR OWN machine (localhost), not in the cloud.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=visionsuite
POSTGRES_USER=visionsuite_user
# Set this to the password you chose when creating the user (see SETUP_POSTGRES.md).
POSTGRES_PASSWORD=change_me

# Optional: SQLAlchemy pool size / overflow (tune for high concurrency).
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
