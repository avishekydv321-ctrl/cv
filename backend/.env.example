# FastAPI Backend Configuration
DATABASE_URL=postgresql+psycopg://visionsuite_user:change_me@localhost:5432/visionsuite
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change_me_to_a_strong_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=
UPLOAD_DIR=/tmp/visionsuite_uploads
OUTPUT_DIR=/tmp/visionsuite_output

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:3000,https://visionsuite.vercel.app

# Model paths
YOLO_WEIGHTS_DIR=./models
PLATE_MODEL_DIR=./models/license_plate

# Inference
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.45
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=300

# Feature flags
ENABLE_EASYOCR=true
ENABLE_TESSERACT=false
ENABLE_FACE_RECOGNITION=false
ENABLE_GPU=false
